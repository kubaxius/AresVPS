# ai_generated
[Unit]
Description={{ operation | capitalize }} static site {{ static_site_name }} release %i
After=network.target nginx.service
Requires=nginx.service

[Service]
Type=oneshot
ExecStart={{ static_site_controller_path }} --config {{ static_site_controller_config_path }} {{ operation }} %i
User=root
Group=root
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths={{ static_site_root }}
RestrictAddressFamilies=AF_UNIX AF_INET AF_NETLINK
SystemCallArchitectures=native
LockPersonality=yes
