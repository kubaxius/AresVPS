server {
    listen 100.108.231.143:443 ssl;
    server_name search.pan.bearworks.pl;

    ssl_certificate /etc/letsencrypt/live/pan.bearworks.pl/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pan.bearworks.pl/privkey.pem;

    location / {
        proxy_pass http://100.108.68.135:80;
        proxy_set_header Host search.pan.bearworks.pl;
        proxy_set_header X-Forwarded-Host search.pan.bearworks.pl;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Port 443;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
